 import { startServerTicks, stopServerTicks } from "./server-tick";
+import { startWsGateway, type GatewayHandle, type PeerEmitter } from "../services/ws-gateway";
+
+let wsGateway: GatewayHandle | null = null;
+
+/**
+ * Starts the WebSocket gateway for browser clients. Environment:
+ *   WS_GATEWAY_PORT     default 17903, 0 disables
+ *   WS_GATEWAY_HOST     default 0.0.0.0; use 127.0.0.1 when a reverse proxy runs on the same host
+ *   WS_ALLOWED_ORIGINS  comma separated, e.g. https://game.example.com (same-host origins are always allowed)
+ *   WS_TRUST_PROXY=1    trust X-Forwarded-For (only when the gateway is reachable solely through your proxy)
+ */
+function startWebGateway(): void {
+  const port = Number(process.env.WS_GATEWAY_PORT ?? 17903);
+  if (!port) return;
+  const hostname = process.env.WS_GATEWAY_HOST ?? "0.0.0.0";
+  const trustProxy = process.env.WS_TRUST_PROXY === "1";
+  if (trustProxy && hostname === "0.0.0.0") {
+    logger.warn("WS_TRUST_PROXY=1 but the gateway listens on 0.0.0.0: clients can spoof X-Forwarded-For. Set WS_GATEWAY_HOST=127.0.0.1 or firewall the port.");
+  }
+  wsGateway = startWsGateway({
+    port,
+    hostname,
+    allowedOrigins: (process.env.WS_ALLOWED_ORIGINS ?? "")
+      .split(",")
+      .map((s) => s.trim())
+      .filter(Boolean),
+    trustProxy,
+    resolve: (p) => serverManager.getServer(`server-${p}`)?.host.emitter as unknown as PeerEmitter | undefined,
+    logger,
+  });
+}
 
